# Google API Key via Gemini API
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_main_google_api_key_here

# Mistral API Key
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Logfire token for monitoring and debugging
# Get your token from: https://pydantic.dev/logfire
LOGFIRE_TOKEN=your_logfire_token_here

# Name of the database to connect to when launching the web UI
DATABASE=name_of_your_database_here

# Default model to use for the SEQUEL2SQL benchmark
DEFAULT_MODEL=google-gla:gemini-3-flash-preview OR mistral-large-latest